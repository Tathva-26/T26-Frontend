# Backend integration. Copy to `.env.local` and adjust.
# Every variable here is NEXT_PUBLIC_, so all of it ships to the browser.
# Nothing secret belongs in this file.

# Backend origin. `NEXT_PUBLIC_API` is a legacy alias, read only if this is unset.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Set to "false" to render a "coming soon" state everywhere instead of calling the API.
NEXT_PUBLIC_BACKEND_ENABLED=true

# Set to "true" to answer every request from src/lib/mock/ with no network at all.
# This is how the frontend is developed while the API is unavailable.
NEXT_PUBLIC_USE_MOCK_DATA=true

# The Event.type an admin puts on pass events. The passes UI queries exactly this value.
NEXT_PUBLIC_PASS_EVENT_TYPE=passes

# When set, sent as additionalData: { role } on sign-in. Only for CA-role deployments.
# NEXT_PUBLIC_OAUTH_ROLE=CA

# Must match the host in the backend's R2_PUBLIC_URL, and is added to
# next/image's remote allowlist in next.config.mjs.
NEXT_PUBLIC_IMAGE_HOST=cdn.tathva.org
